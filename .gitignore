# ========================================
# .GITIGNORE - Archivos que NO subimos a Git
# ========================================

# Dependencias / node_modules (si usas Astro/Vite luego)
node_modules/
dist/
build/
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing / Coverage
coverage/
.nyc_output/

# Misc
*.pem
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# OS
.DS_Store
ehthumbs.db
Desktop.ini

# Archivos grandes / binarios que no versionamos
*.zip
*.tar.gz
*.rar
*.7z

# Fuentes locales (si las descargas)
assets/fonts/*.woff
assets/fonts/*.woff2
assets/fonts/*.ttf

# Imágenes optimizadas generadas (si usas scripts de optimización)
assets/img/optimized/